@using Microsoft.AspNetCore.Components.Authorization
@using AuthTemplate.Client.AuthPages

@* הקוד אחראי על שני דברים: הניתוב בין העמודים, ואספקת פרטי המשתמש*@

@inject IAuthenticationService _Auth


<CascadingAuthenticationState>

    <!-- פרטי המשתמש- משותפים לכולם -->
    <CascadingValue Value="user">
    @* הראוטר סורק את ההרכבה ומוצא את העמודים לפי @page שלהם *@
        <Router AppAssembly="@typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">

                    <!-- בזמן האימות -->
                    <Authorizing>
                        <text>Please wait, we are authorizing the user.</text>
                    </Authorizing>

                    <NotAuthorized>
                        <!-- אין אישור -->
                        <NotAllowed/>
                    </NotAuthorized>

                </AuthorizeRouteView>
            </Found>
            <NotFound>
                <!-- דף לא קיים -->
                <LayoutView Layout="@typeof(MainLayout)">
                    <PageTitle>Not found</PageTitle>
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
</CascadingAuthenticationState>

@code {

    // פרטי המשתמש המחובר
    User? user;

    protected override async Task OnInitializedAsync()
    {
        //קבלת פרטי המשתמש
        _Auth.OnAuthenticationStateChanged += HandleAuthenticationStateChanged;
        user = await _Auth.GetUserFromClaimAsync();
    }

    // מרענן את פרטי המשתמש בכל כניסה או יציאה
    private async void HandleAuthenticationStateChanged()
    {
        user = await _Auth.GetUserFromClaimAsync();
        StateHasChanged(); // רענון הקומפוננטה
    }

    public void Dispose()
    {
        _Auth.OnAuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }

}
