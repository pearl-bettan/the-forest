@* ==========================================================
   הפריסה הראשית של כל עמודי האתר.
   מגדירה את השלד הקבוע: סרגל הניווט למעלה ותוכן העמוד
   מתחתיו. הראוטר ב-App.razor מפנה לכאן כל עמוד שלא הגדיר
   פריסה משלו, ולכן זה המקום היחיד שבו מופיע NavMenu
   ========================================================== *@

@inherits LayoutComponentBase

<div class="page">
    @* ---------- סרגל הניווט העליון, קבוע בכל העמודים ---------- *@
    <div class="top-row">
        <NavMenu />
    </div>

    @* ---------- תוכן העמוד שנבחר בראוטר ---------- *@
    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>
