@page "/Play"
@page "/Play/{code:int}"

@implements IDisposable

@* ==========================================================
   עמוד המשחק. מטמיע את בניית היוניטי שיושבת ב-wwwroot/Game
   בתוך iframe, ומעביר לה את קוד המשחק בכתובת.
   קוד 0 פירושו שלא נשלח קוד, ואז השחקן מקליד אותו במסך הפתיחה

   שלושה מצבים, לפי הפיגמה (גרסה 5):
     Loading - לוגו, "עוד רגע יוצאים לדרך...", פס התקדמות וגמד ממתין
     Error   - לוגו, "אוי לא משהו השתבש...", כפתור ניסיון חוזר וגמד מודאג
     Ready   - המשחק עצמו
   ========================================================== *@

<PageTitle>יער הידע - משחק</PageTitle>

<div class="play-page">

    @if (state == PlayState.Loading)
    {
        <div class="play-state">
            <StatusScreen />
        </div>
    }
    else if (state == PlayState.Error)
    {
        <div class="play-state" role="alert">
            <StatusScreen Title="אוי לא משהו השתבש..."
                          Image="assets-images/dwarf-error.png">
                <button class="play-retry" type="button"
                        title="ניסיון חוזר" @onclick="Retry">
                    <img src="assets-images/refresh.png" alt="ניסיון חוזר" />
                </button>
            </StatusScreen>
        </div>
    }

    @* המסגרת נשארת במסמך גם בזמן הטעינה, אחרת האירוע onload
       לא יגיע אף פעם. היא רק מוסתרת *@
    <div class="play-frame @(state == PlayState.Ready ? "" : "play-frame-hidden")">
        <iframe @key="attempt"
                title="יער הידע"
                width="1280" height="758" scrolling="no"
                src="@GameUrl()"
                @onload="GameLoaded"></iframe>
    </div>

</div>


@code {

    // קוד המשחק שמגיע מהכתובת. 0 = לא נשלח קוד
    [Parameter]
    public int code { get; set; }

    private enum PlayState { Loading, Ready, Error }

    private PlayState state = PlayState.Loading;

    // מזהה הניסיון. שינוי שלו מכריח את Blazor לבנות iframe חדש,
    // וכך האירוע onload נורה שוב בניסיון חוזר
    private int attempt = 0;

    // אחרי כמה שניות בלי onload מוצג מסך השגיאה
    private const int TimeoutSeconds = 30;

    private CancellationTokenSource timeoutSource;

    // מפעיל את שעון העצר כבר בטעינת העמוד, כדי שמשחק שלא
    // נטען כלל לא ישאיר את השחקן במסך טעינה לנצח
    protected override void OnInitialized()
    {
        StartTimeout();
    }

    // בלי קוד תקין לא מוסיפים ?code= בכלל. אחרת המשחק היה שולח
    // code=0 לשרת, מקבל "קוד המשחק חייב להיות מספר חיובי",
    // ומציג שגיאה במסך הפתיחה עוד לפני שהשחקן הקליד משהו
    private string GameUrl()
    {
        if (code <= 0) return "Game/index.html";

        return $"Game/index.html?code={code}";
    }

    // נקרא מאירוע onload של המסגרת. מעביר למצב "מוכן" ומבטל
    // את שעון העצר. הבדיקה בתחילתו מונעת מ-onload חוזר לשנות
    // מצב אחרי שכבר הוצגה שגיאה
    private void GameLoaded()
    {
        if (state != PlayState.Loading) return;

        state = PlayState.Ready;
        CancelTimeout();
    }

    // ניסיון חוזר: קידום מזהה הניסיון בונה iframe חדש לגמרי,
    // כי @key השתנה. בלי זה הדפדפן היה משאיר את המסגרת הקיימת
    // ו-onload לא היה נורה שוב
    private void Retry()
    {
        attempt = attempt + 1;
        state = PlayState.Loading;
        StartTimeout();
    }

    // מאתחל את שעון העצר. מבטל קודם כל שעון קיים, כדי ששני
    // ניסיונות רצופים לא יריצו שתי המתנות במקביל
    private void StartTimeout()
    {
        CancelTimeout();

        timeoutSource = new CancellationTokenSource();

        // לא ממתינים כאן. המתודה חוזרת ב-await הראשון,
        // והמשך הריצה קורה רק אם הזמן עבר בלי onload
        _ = WatchTimeout(timeoutSource.Token);
    }

    // ממתין למשך הפסק זמן, ואם המשחק עדיין לא נטען מציג שגיאה.
    // StateHasChanged נקרא דרך InvokeAsync כי ההמשך רץ מחוץ
    // לחוט הרינדור של Blazor
    private async Task WatchTimeout(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(TimeoutSeconds), token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested == true) return;
        if (state != PlayState.Loading) return;

        state = PlayState.Error;

        await InvokeAsync(StateHasChanged);
    }

    // מבטל ומשחרר את שעון העצר, אם קיים
    private void CancelTimeout()
    {
        if (timeoutSource == null) return;

        timeoutSource.Cancel();
        timeoutSource.Dispose();
        timeoutSource = null;
    }

    // ביטול שעון העצר ביציאה מהעמוד. בלעדיו ההמתנה הייתה
    // ממשיכה לרוץ וניגשת למצב של עמוד שכבר נסגר
    public void Dispose()
    {
        CancelTimeout();
    }
}
