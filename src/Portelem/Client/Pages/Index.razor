@page "/"

@* ==========================================================
   עמוד הבית של המחולל, בכתובת הראשית של האתר.
   מציג ברכה אישית ומעבר לרשימת המשחקים למשתמש מחובר,
   והודעה עם הפניה לפורטל למשתמש שאינו מחובר.
   פרטי המשתמש אינם נשלפים כאן מהשרת אלא מגיעים כפרמטר
   מדורג מרכיב האב, ולכן אין בעמוד קריאת API כלל
   ========================================================== *@

@inject IConfiguration _config

<PageTitle>יער הידע</PageTitle>

@* מעטפת העמוד. כל התוכן שבתוכה נקבע לפי מצב ההתחברות *@
<div class="home-page">

    <AuthorizeView>

        @* ---------- משתמש מחובר ---------- *@
        <Authorized>
            @if (user != null)
            {
                <h1 class="home-title">היי @user.FirstName @user.LastName</h1>
            }

            <p class="home-text">ברוכים הבאים למחולל של יער הידע</p>

            @* מעבר למסך המשחקים שלי, נקודת הכניסה לעבודה במחולל *@
            <NavLink class="btn-second home-link" href="./GamesList">
                המשחקים שלי
            </NavLink>
        </Authorized>

        @* ---------- משתמש לא מחובר ---------- *@
        <NotAuthorized>
            <h1 class="home-title">אין משתמש מחובר</h1>

            <p class="home-text">
                כדי ליצור ולערוך משחקים יש להתחבר דרך הפורטל"מ
            </p>

            @* קישור חיצוני לפורטל"מ, ולכן a ולא NavLink: NavLink
               מיועד לניווט פנימי בתוך האתר *@
            <a class="btn-second home-link" href="@_config["portelem:mainUrl"]">
                מעבר לפורטל״מ
            </a>
        </NotAuthorized>

    </AuthorizeView>

</div>


@code {

    // המשתמש המחובר, מגיע כפרמטר מדורג מרכיב האב.
    // null כשאין משתמש מחובר, ואז מוצג הענף NotAuthorized
    [CascadingParameter]
    private User user { get; set; }

}
