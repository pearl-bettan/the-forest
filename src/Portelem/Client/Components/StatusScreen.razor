<div class="status-screen">

    <img src="assets-images/logo-forest-big.png" alt="יער הידע"
         class="status-logo" width="351" height="234" />

    <p class="status-title">@Title</p>

    @if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        @* מסך טעינה*@
        <div class="status-progress" role="progressbar"
             aria-label="@Title" aria-busy="true">
            <span class="status-progress-fill"></span>
        </div>
    }

    <img src="@Image" alt="" class="status-dwarf" />

</div>


@code {

    // הכיתוב שמתחת ללוגו
    [Parameter]
    public string Title { get; set; } = "עוד רגע יוצאים לדרך...";

    // התמונה של הגמד
    [Parameter]
    public string Image { get; set; } = "assets-images/dwarf-waiting.png";

    // תוכן שמחליף את פס ההתקדמות, למשל כפתור ניסיון חוזר
    [Parameter]
    public RenderFragment ChildContent { get; set; }
}
