@using AuthTemplate.Shared.Models.Games

<div class="items-row">

    @*  יבשת ימין  *@
    <div class="item-card">
        <div class="item-media tag-media">
            <span class="item-text">@TagText(Question.RightTag)</span>
        </div>
    </div>

    @*  אבני התשובה  *@
    @foreach (AnswerToEdit answer in Question.Answers)
    {
        <div class="item-card">
            <div class="item-media rock-media">
                @if (answer.IsImage == true)
                {
                    <img class="item-img" src="uploadedFiles/@answer.Content" alt="" />
                }
                else
                {
                    <span class="item-text @TextSize(answer.Content)">@answer.Content</span>
                }
            </div>

        </div>
    }

    @*  יבשת שמאל  *@
    <div class="item-card">
        <div class="item-media tag-media">
            <span class="item-text">@TagText(Question.LeftTag)</span>
        </div>
    </div>

</div>


@code {

    // השאלה שאת הפריטים שלה מציגים
    [Parameter]
    public QuestionToEdit Question { get; set; }

    // נשמר לצורך אחידות מול טופס העריכה
    [Parameter]
    public bool ReadOnly { get; set; } = true;


    // כל עוד לא הוזן ערך קיצון, מוצג טקסט ברירת מחדל
    string TagText(string tag)
    {
        if (string.IsNullOrWhiteSpace(tag))
        {
            return "ערך קיצון";
        }

        return tag;
    }

    
    string TextSize(string text)
    {
        int length = (text == null) ? 0 : text.Length;

        if (length <= 12)
        {
            return "";
        }

        if (length <= 20)
        {
            return "text-mid";
        }

        return "text-long";
    }
}
