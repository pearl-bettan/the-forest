@*טופס עריכת שאלה*@

@using AuthTemplate.Shared.Models.Games
@inject HttpClient Http
@inject IJSRuntime JS

<div class="question-body">

    @*  שורת ההסבר לפרטי מינימום ומקסימום בשאלה *@
    <p class="items-hint">
        יש להזין את ערכי הקיצון ביבשות ולסדר את הפריטים בהתאם.
        אפשר לשמור שאלה כטיוטה בכל שלב. לפרסום המשחק צריך 3 עד 10 פריטים בכל שאלה.
    </p>

    @*  שורת הפריטים  *@
    <div class="items-row">

        @* תגית קצה ימינית  *@
        <div class="item-card">
            <div class="item-media tag-media">
                <span class="item-text @(string.IsNullOrWhiteSpace(Question.RightTag) ? "is-placeholder" : "")">
                    @TagText(Question.RightTag)
                </span>
            </div>

            <div class="item-tools">
                <span class="tip" data-tip="עריכת ערך הקיצון">
                    <button type="button" class="tool-btn" @onclick="() => OpenTagPopup(true)">
                        <img src="assets-images/pen.svg" alt="עריכה" class="tool-icon" />
                    </button>
                </span>
                <span></span>
            </div>
        </div>

        @*  הפריטים שהוזנו *@
        @for (int i = 0; i < Question.Answers.Count; i++)
        {
            int pos = i;
            AnswerToEdit answer = Question.Answers[pos];

            <div class="item-card @(dragIndex == pos ? "is-dragging" : "")"
                 draggable="true"
                 @ondragstart="() => StartDrag(pos)"
                 @ondragover:preventDefault="true"
                 @ondrop="() => DropOn(pos)"
                 @ondragend="EndDrag">

                <div class="item-media rock-media">
                    @if (answer.IsImage == true)
                    {
                        <img class="item-img" src="uploadedFiles/@answer.Content" alt="" draggable="false" />
                    }
                    else
                    {
                        <span class="item-text @TextSize(answer.Content)">@answer.Content</span>
                    }

                    @* אייקון המחיקה מופיע רק במעבר עכבר *@
                    <button type="button" class="item-remove"
                            title="@RemoveTitle()"
                            disabled="@(CanRemove() == false)"
                            @onclick="() => AskRemove(pos)">
                        <img src="assets-images/bin.svg" alt="מחיקה" width="12" height="12" />
                    </button>
                </div>

                <div class="item-tools">
                    <span class="tip" data-tip="עריכת הפריט">
                        <button type="button" class="tool-btn" @onclick="() => OpenEditItem(pos)">
                            <img src="assets-images/pen.svg" alt="עריכה" class="tool-icon" />
                        </button>
                    </span>

                    @* זכוכית מגדלת- רק לפריטי תמונה, ורק במצב עריכה *@
                    @if (answer.IsImage == true)
                    {
                        <span class="tip" data-tip="הצגת התמונה בגדול">
                            <button type="button" class="tool-btn"
                                    @onclick="() => OpenZoom(answer.Content)">
                                <img src="assets-images/zoom.svg" alt="הגדלה" class="tool-icon" />
                            </button>
                        </span>
                    }

                    <span class="tip" data-tip="גרירה לשינוי הסדר">
                        <img src="assets-images/all-directions.svg" alt="" class="tool-icon drag-icon" />
                    </span>
                </div>
            </div>
        }

        @* פריטים ריקים להוספה *@
        @for (int i = 0; i < EmptySlots(); i++)
        {
            <div class="item-card is-empty">
                <div class="item-media rock-media">
                    <span class="tip" data-tip="הוספת פריט">
                        <button type="button" class="add-item-btn" aria-label="הוספת פריט"
                                @onclick="OpenAddItem"></button>
                    </span>
                </div>

                @*  אייקוני העריכה מוצגים גם בסלע ריק, אבל כבויים עד שמוזן לתוכו תוכן *@
                <div class="item-tools is-off">
                    <img src="assets-images/pen.svg" alt="" class="tool-icon" />
                    <img src="assets-images/all-directions.svg" alt="" class="tool-icon" />
                </div>
            </div>
        }

        @*  תג קיצון שמאל  *@
        <div class="item-card">
            <div class="item-media tag-media">
                <span class="item-text @(string.IsNullOrWhiteSpace(Question.LeftTag) ? "is-placeholder" : "")">
                    @TagText(Question.LeftTag)
                </span>
            </div>

            <div class="item-tools">
                <span class="tip" data-tip="עריכת ערך הקיצון">
                    <button type="button" class="tool-btn" @onclick="() => OpenTagPopup(false)">
                        <img src="assets-images/pen.svg" alt="עריכה" class="tool-icon" />
                    </button>
                </span>
                <span></span>
            </div>
        </div>

    </div>

    @*שמירה וביטול *@
    <div class="question-actions">
        <span class="tip tip-wide" data-tip="@SaveTip()">
            <button type="button" class="btn-green"
                    disabled="@(IsReady() == false)"
                    @onclick="HandleSave">שמירה</button>
        </span>

        <span class="tip tip-wide" data-tip="בלחיצה על “ביטול”, שינויים שלא נשמרו - יימחקו">
            <button type="button" class="btn-green" @onclick="AskCancel">ביטול</button>
        </span>
    </div>

</div>


@*פופאפ הוספת ועריכת פריט*@
@if (isItemPopupOpen == true)
{
    <div class="popup-background">
        <div class="popup-inner rock-popup" tabindex="-1">

            <h2 class="popup-title">@(editIndex < 0 ? "הוספת סלע" : "עריכת סלע")</h2>
            <p class="popup-subtitle">יש לבחור סוג תוכן בלחיצה על האייקון</p>

            @* הסלע שנבחר ומוזן בו תוכן *@
            <div class="big-rock">

                @if (itemType == "")
                {
                    @* בחירת סוג התוכן *@
                    <div class="type-choice">
                        <button type="button" class="type-btn" @onclick='() => itemType = "text"'>
                            <img src="assets-images/content-text.svg" alt="טקסט" />
                        </button>

                        <span class="type-or">או</span>

                        <span class="tip tip-wide"
                              data-tip="ניתן להעלות קבצי jpg, png ו-jpeg בלבד, עד 5MB">
                            <button type="button" class="type-btn" @onclick="ChooseImage">
                                <img src="assets-images/content-image.svg" alt="תמונה" />
                            </button>
                        </span>
                    </div>
                }
                else if (itemType == "text")
                {
                    
                    <textarea class="rock-input @(itemBlink ? "limit-blink" : "")"
                              dir="auto"
                              maxlength="@ItemMax" placeholder="הקלדת טקסט"
                              @bind="itemText" @bind:event="oninput"
                              @onkeydown="OnItemKeyDown"></textarea>

                    <span class="rock-counter @ItemCounterClass() @(itemBlink ? "count-blink" : "")">@itemText.Length/@ItemMax</span>
                }
                else
                {
                    @* תצוגה מקדימה של התמונה שנבחרה *@
                    @if (itemFile != "")
                    {
                        <img class="rock-preview" src="uploadedFiles/@itemFile" alt="" />
                    }
                    else
                    {
                        <span class="rock-waiting">בחרו תמונה מהמחשב</span>
                    }
                }

                @* כפתור ההעלאה מוסתר, וכפתור התמונה מפעיל אותו *@
                <InputFile id="itemFileInput" OnChange="UploadImage"
                           accept=".png,.jpg,.jpeg" hidden />
            </div>

            @* הודעה שההעלאה בתהליך *@
            @if (isUploading == true)
            {
                <p class="upload-note">מעלה תמונה...</p>
            }

            @* שגיאת העלאה *@
            @if (uploadMsg != "")
            {
                <p class="upload-error" role="alert">@uploadMsg</p>
            }

            @* החלפת סוג התוכן אחרי שכבר נבחר *@
            @if (itemType != "")
            {
                <div class="type-switch">
                    <button type="button" class="type-btn-sm @(itemType == "text" ? "is-on" : "")"
                            @onclick='() => itemType = "text"'>
                        <img src="assets-images/content-text.svg" alt="טקסט" />
                    </button>

                    <span class="tip tip-wide"
                          data-tip="ניתן להעלות קבצי jpg, png ו-jpeg בלבד, עד 5MB">
                        <button type="button" class="type-btn-sm @(itemType == "image" ? "is-on" : "")"
                                @onclick="ChooseImage">
                            <img src="assets-images/content-image.svg" alt="תמונה" />
                        </button>
                    </span>
                </div>
            }

            @* כפתור ההוספה מופיע רק אחרי שנבחר סוג תוכן*@
            <div class="popup-actions">
                @if (itemType != "")
                {
                    <button type="button" class="btn-main btn-ctx-green"
                            disabled="@(CanSaveItem() == false || HasItemChanged() == false || isUploading == true)"
                            @onclick="SaveItem">
                        שמירה
                    </button>
                }

                <span class="tip tip-wide" data-tip="בלחיצה על “ביטול”, שינויים שלא נשמרו - יימחקו">
                    <button type="button" class="btn-main btn-ctx-green" @onclick="CloseItemPopup">ביטול</button>
                </span>
            </div>

        </div>
    </div>
}


@* פופאפ עריכת ערך קיצון*@
@if (isTagPopupOpen == true)
{
    <div class="popup-background">
        <div class="popup-inner tag-popup" tabindex="-1">

            <h2 class="popup-title">ערך קיצון</h2>
            <p class="popup-subtitle">
                @(isRightTag ? "היבשת שבצד ימין של הרצף" : "היבשת שבצד שמאל של הרצף")
            </p>

            <div class="big-tag">
                <input class="tag-input @(tagBlink ? "limit-blink" : "")" maxlength="@TagMax"
                       dir="auto"
                       value="@tagText"
                       @oninput="(e) => tagText = e.Value.ToString()"
                       @onkeydown="OnTagKeyDown" />

                <span class="rock-counter @TagCounterClass() @(tagBlink ? "count-blink" : "")">@tagText.Length/@TagMax</span>
            </div>

            <div class="popup-actions">
                <span class="tip tip-wide" data-tip="שמירת שינויים">
                    <button type="button" class="btn-main btn-ctx-green"
                            disabled="@(CanSaveTag() == false || tagText == origTagText)"
                            @onclick="SaveTag">שמירה</button>
                </span>

                <span class="tip tip-wide" data-tip="בלחיצה על “ביטול”, שינויים שלא נשמרו - יימחקו">
                    <button type="button" class="btn-main btn-ctx-green" @onclick="CloseTagPopup">ביטול</button>
                </span>
            </div>

        </div>
    </div>
}


@*הגדלת תמונת פריט*@
@if (zoomFile != "")
{
    <div class="popup-background" @onclick="CloseZoom">
        <div class="popup-inner zoom-popup" tabindex="-1" @onclick:stopPropagation="true">

            <button type="button" class="popup-close" @onclick="CloseZoom" title="סגירה">
                <img src="assets-images/close.svg" alt="סגירה" width="21" height="20" />
            </button>

            <h2 class="popup-title">תצוגת התמונה</h2>

            <div class="zoom-frame">
                <img class="zoom-img" src="uploadedFiles/@zoomFile" alt="תמונת הפריט" />
            </div>

        </div>
    </div>
}


@* אישור ביטול עריכת השאלה*@
@if (isCancelPopupOpen == true)
{
    <div class="popup-background">
        <div class="popup-inner cancel-popup" tabindex="-1">

            <h2 class="popup-title">שינויים ימחקו</h2>

            <p class="cancel-question">שאלה @QuestionNumber - @Question.Answers.Count פריטים</p>

            <p class="cancel-note">
                לחיצה על ביטול השאלה תמחק את כל הפריטים בה ולא יהיה ניתן לשחזרם
            </p>

            <div class="popup-actions">
                <button type="button" class="btn-main" @onclick="ConfirmCancel">מחק</button>
                <button type="button" class="btn-main" @onclick="CloseCancelPopup">חזור</button>
            </div>

        </div>
    </div>
}


@* אישור מחיקת פריט *@
@if (removeIndex >= 0)
{
    <div class="popup-background">
        <div class="popup-inner popup-small" tabindex="-1">
            <h2 class="popup-title">מחיקת פריט</h2>
            <p class="delete-text">למחוק את הפריט מהרצף?</p>

            <div class="popup-actions">
                <button type="button" class="btn-main" @onclick="RemoveItem">כן, למחוק</button>
                <button type="button" class="btn-second" @onclick="() => removeIndex = -1">ביטול</button>
            </div>
        </div>
    </div>
}


@code {

    [Parameter]
    public QuestionToEdit Question { get; set; }
    [Parameter]
    public EventCallback OnSave { get; set; }
    [Parameter]
    public EventCallback OnCancel { get; set; }

    // מספר השאלה
    [Parameter]
    public int QuestionNumber { get; set; }
    [Parameter]
    public EventCallback OnItemsChanged { get; set; }

    const int ItemMax = 30;
    const int TagMax = 10;
    const int MinItems = 3;
    const int MaxItems = 10;

    // פופאפ הפריט 
    bool isItemPopupOpen = false;

    // 1- פירושו הוספת פריט חדש
    int editIndex = -1;

    // סוג התוכן שנבחר: ריק לפני בחירה, אחרת text או image
    string itemType = "";

    // הטקסט שהוקלד, כשסוג התוכן הוא טקסט
    string itemText = "";

    // שם קובץ התמונה שהועלתה לשרת
    string itemFile = "";

    // הערכים ברגע פתיחת הפופאפ, כדי לזהות אם התוכן שונה
    string origItemType = "";
    string origItemText = "";
    string origItemFile = "";

    // פופאפ ערך הקיצון
    bool isTagPopupOpen = false;

    bool isRightTag = true;

    // הטקסט שהוקלד בפופאפ התגית
    string tagText = "";

    // ערך התגית ברגע פתיחת הפופאפ, כדי לזהות אם הוקלד שינוי
    string origTagText = "";

    // מחיקת פריט
    int removeIndex = -1;

    //  הגדלת תמונה 
    string zoomFile = "";

    //  גרירה 
    int dragIndex = -1;



    // אבני ההוספה הריקים
    int EmptySlots()
    {
        if (Question.Answers.Count < MinItems)
        {
            return MinItems - Question.Answers.Count;
        }

        if (Question.Answers.Count < MaxItems)
        {
            return 1;
        }

        return 0;
    }


    
    // פופאפ עריכת פריט

    void OpenAddItem()
    {
        editIndex = -1;
        itemType = "";
        itemText = "";
        itemFile = "";

        origItemType = "";
        origItemText = "";
        origItemFile = "";

        isItemPopupOpen = true;
    }


    // פותח את הפופאפ על פריט קיים
    void OpenEditItem(int index)
    {
        AnswerToEdit answer = Question.Answers[index];

        editIndex = index;

        if (answer.IsImage == true)
        {
            itemType = "image";
            itemFile = answer.Content;
            itemText = "";
        }
        else
        {
            itemType = "text";
            itemText = answer.Content;
            itemFile = "";
        }

        origItemType = itemType;
        origItemText = itemText;
        origItemFile = itemFile;

        isItemPopupOpen = true;
    }


    // סוגר את פופאפ הפריט
    async Task CloseItemPopup()
    {
        await CleanUploads("");

        isItemPopupOpen = false;
    }


    // בחירת תוכן מסוג תמונה פותחת מיד את חלון הקבצים במחשב
    async Task ChooseImage()
    {
        itemType = "image";

        await JS.InvokeVoidAsync("forestGame.clickElement", "itemFileInput");
    }


    // האם העלאה מתבצעת כרגע
    bool isUploading = false;

    // הודעת שגיאה של ההעלאה
    string uploadMsg = "";

    
    // קוראת את הקובץ, שולחת אותו לשרת ושומרת את שם הקובץ שחזר
    async Task UploadImage(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;

        if (file == null) return;

        isUploading = true;
        uploadMsg = "";

        try
        {
            using (var stream = file.OpenReadStream(MaxUploadBytes))
            {
                MemoryStream memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                byte[] buffer = memory.ToArray();

                ImageToUpload image = new ImageToUpload();
                image.ImageBase64 = Convert.ToBase64String(buffer);
                image.Extension = Path.GetExtension(file.Name).Replace(".", "");

                var res = await Http.PostAsJsonAsync("api/games/uploadImage/", image);

                if (res.IsSuccessStatusCode == true)
                {
                    string saved = await res.Content.ReadAsStringAsync();

                    // הקובץ הקודם של הפופאפ הזה כבר לא בשימוש
                    RememberUpload(saved);

                    itemFile = saved;
                }
                else
                {
                    string error = await res.Content.ReadAsStringAsync();

                    uploadMsg = error == "Image not valid"
                        ? "הקובץ אינו תמונה תקינה"
                        : "העלאת התמונה נכשלה, נסו שוב";
                }
            }
        }
        catch (IOException)
        {
            // OpenReadStream הודעה כשהקובץ גדול מהמגבלה
            uploadMsg = "הקובץ גדול מדי. הגודל המרבי הוא 5 מגהבייט";
        }
        catch (Exception)
        {
            uploadMsg = "העלאת התמונה נכשלה, נסו שוב";
        }
        finally
        {
            isUploading = false;
        }
    }

    // הגודל המרבי לקובץ שנקרא מהדפדפן
    const int MaxUploadBytes = 5 * 1024 * 1024;

    
    // ניקוי תמונות שהועלו ולא נשמרו
    List<string> uploadedInPopup = new List<string>();

    void RememberUpload(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName) == true) return;

        if (uploadedInPopup.Contains(fileName) == false) uploadedInPopup.Add(fileName);
    }

    // מוחקת מהשרת את מה שהועלה בפופאפ ולא נשמר
    async Task CleanUploads(string keep)
    {
        foreach (string name in uploadedInPopup)
        {
            if (name == keep) continue;

            if (name == origItemFile) continue;

            try
            {
                await Http.DeleteAsync("api/games/deleteImage/" + name);
            }
            catch (Exception)
            {
                // ניקוי שנכשל - ממשיך ולא עוצר את המחולל
            }
        }

        uploadedInPopup.Clear();
    }


    // צבע מונה התווים של הפריט: ירוק כשתקין, אדום בחריגה
    // הבהוב מסגרת אדום כשמנסים לחרוג ממגבלת התווים
    bool itemBlink = false;
    bool tagBlink = false;

    // הבהוב אדום של מונה הפריט כשמנסים לחרוג מ-30 התווים
    async Task OnItemKeyDown(KeyboardEventArgs e)
    {
        if (itemText.Length >= ItemMax && IsTypingKey(e))
        {
            // הבהוב אדום קצר בכל ניסיון להקליד מעבר למקסימום
            itemBlink = true;
            await Task.Delay(220);
            itemBlink = false;
        }
    }

    // הבהוב אדום של מונה ערך הקיצון כשמנסים לחרוג מ-10 התווים
    async Task OnTagKeyDown(KeyboardEventArgs e)
    {
        if (tagText.Length >= TagMax && IsTypingKey(e))
        {
            // הבהוב אדום קצר בכל ניסיון להקליד מעבר למקסימום
            tagBlink = true;
            await Task.Delay(220);
            tagBlink = false;
        }
    }

    // מקש שמכניס תו בודד, להבדיל ממקשי ניווט/מחיקה/קיצור
    bool IsTypingKey(KeyboardEventArgs e)
    {
        return e.Key != null && e.Key.Length == 1
               && e.CtrlKey == false && e.MetaKey == false && e.AltKey == false;
    }


    // צבע מונה התווים של הפריט: ירוק כשתקין, אדום במגבלה
    string ItemCounterClass()
    {
        if (itemText.Length == 0)
        {
            return "chars-short";
        }

        return "chars-ok";
    }


    // האם התוכן שונה מרגע פתיחת הפופאפ. עד שאין שינוי אי אפשר לשמור
    bool HasItemChanged()
    {
        if (itemType != origItemType)
        {
            return true;
        }

        if (itemType == "text")
        {
            return itemText != origItemText;
        }

        if (itemType == "image")
        {
            return itemFile != origItemFile;
        }

        return false;
    }


    // האם התוכן תקין לשמירה: טקסט לא ריק ובתוך המגבלה,
    // או תמונה שהועלתה בהצלחה וקיבלה שם קובץ
    bool CanSaveItem()
    {
        if (itemType == "text")
        {
            if (string.IsNullOrWhiteSpace(itemText) == true)
            {
                return false;
            }

            return itemText.Length <= ItemMax;
        }

        if (itemType == "image")
        {
            return itemFile != "";
        }

        return false;
    }


    // ============================================================
    // שומר את הפריט ברשימה שבזיכרון - לא בשרת.
    //
    // השמירה לשרת מתרחשת רק כששומרים את השאלה כולה, ולכן
    // ביטול העריכה בעמוד מבטל גם את כל שינויי הפריטים.
    //
    // פריט חדש מתווסף בסוף הרשימה, וקיים מעודכן במקומו.
    // בסוף נשלחת הודעה לעמוד, כדי שמונה הפריטים בכותרת יתעדכן
    // ============================================================
    async Task SaveItem()
    {
        AnswerToEdit answer;

        if (editIndex < 0)
        {
            answer = new AnswerToEdit();
        }
        else
        {
            answer = Question.Answers[editIndex];
        }

        if (itemType == "image")
        {
            answer.IsImage = true;
            answer.Content = itemFile;
        }
        else
        {
            answer.IsImage = false;
            answer.Content = itemText.Trim();
        }

        if (editIndex < 0)
        {
            Question.Answers.Add(answer);
        }

        isItemPopupOpen = false;

        // כל מה שהועלה בפופאפ ולא נבחר בסוף - מיותר עכשיו
        await CleanUploads(answer.IsImage == true ? answer.Content : "");

        await OnItemsChanged.InvokeAsync();
    }


    // ==========================================================
    // הגדלת תמונה
    // ==========================================================

    void OpenZoom(string fileName)
    {
        zoomFile = fileName;
    }


    // סוגר את תצוגת ההגדלה. שם קובץ ריק הוא מצב סגור
    void CloseZoom()
    {
        zoomFile = "";
    }


    // ==========================================================
    // מחיקת פריט
    // ==========================================================

    // מותר למחוק כל פריט כל עוד נשאר לפחות אחד.
    // מגבלת שלושת הפריטים היא תנאי לפרסום ולא לשמירה: שאלה עם
    // פחות משלושה פריטים נשמרת כטיוטה, והמשחק לא ניתן לפרסום
    bool CanRemove()
    {
        return Question.Answers.Count > 0;
    }


    // הטקסט בטולטיפ של סל המחיקה, שמסביר למה הוא כבוי
    string RemoveTitle()
    {
        if (CanRemove() == false)
        {
            return "חובה שיישאר לפחות פריט אחד בשאלה";
        }

        return "מחיקת הפריט";
    }


    // ==========================================================
    // ביטול עריכת השאלה
    // ==========================================================

    // האם פופאפ אישור הביטול פתוח
    bool isCancelPopupOpen = false;


    // ============================================================
    // צילום מצב של השאלה כפי שהיא נפתחה לעריכה.
    //
    // הטופס עובד ישירות על האובייקט שהעמוד מסר לו, ולכן אין ממי
    // לשאול "מה היה כאן קודם". המחרוזת שנשמרת כאן היא התשובה,
    // והיא מה שמאפשר לדעת בלחיצה על ביטול אם בכלל יש מה לאבד
    // ============================================================
    string openedAs = "";

    // האובייקט שממנו נלקח הצילום
    QuestionToEdit snapshotOf;


    // ============================================================
    // מצלמים מחדש רק כששאלה אחרת נפתחה לעריכה.
    //
    // ההשוואה היא על זהות האובייקט ולא על תוכנו: פתיחת שאלה
    // יוצרת בעמוד עותק חדש, ואילו הקלדה בתוך השאלה הפתוחה
    // משנה את אותו אובייקט עצמו. בלי ההבחנה הזאת הצילום היה
    // מתעדכן בכל רינדור, וכל שינוי היה נעלם ברגע שנעשה
    // ============================================================
    protected override void OnParametersSet()
    {
        if (Question == null) return;

        if (ReferenceEquals(snapshotOf, Question) == true) return;

        snapshotOf = Question;
        openedAs = Fingerprint();
    }


    // ============================================================
    // חתימת התוכן של השאלה: ערכי הקיצון והפריטים לפי סדרם.
    //
    // הסדר הוא חלק מהתוכן - גרירת פריט למקום אחר היא שינוי לכל
    // דבר - ולכן החתימה נבנית כמחרוזת מסודרת. התו המפריד אינו
    // ניתן להקלדה, כדי ששני תכנים שונים לא יניבו אותה חתימה
    // ============================================================
    string Fingerprint()
    {
        List<string> parts = new List<string>();

        parts.Add(Question.RightTag);
        parts.Add(Question.LeftTag);

        foreach (AnswerToEdit answer in Question.Answers)
        {
            parts.Add((answer.IsImage == true ? "1" : "0") + answer.Content);
        }

        return string.Join("\u0001", parts);
    }


    // האם משהו השתנה מאז שהשאלה נפתחה לעריכה
    bool HasChanges()
    {
        return Fingerprint() != openedAs;
    }


    // ============================================================
    // לחיצה על "ביטול" אינה מבטלת מיד אלא שואלת קודם.
    //
    // הביטול מוחק את כל מה שלא נשמר, ובשאלה חדשה זה כל הפריטים
    // שהוזנו בה. השאלה לפני הפעולה היא ההגנה היחידה, כי אחרי
    // הביטול אין מה לשחזר.
    //
    // כשלא השתנה דבר אין מה לאבד, והאזהרה רק מעכבת את העורכת -
    // ולכן הביטול קורה מיד
    // ============================================================
    async Task AskCancel()
    {
        if (HasChanges() == false)
        {
            await OnCancel.InvokeAsync();
            return;
        }

        isCancelPopupOpen = true;
    }


    // "חזור" - סוגר את הפופאפ ומשאיר את העריכה כמו שהייתה
    void CloseCancelPopup()
    {
        isCancelPopupOpen = false;
    }


    // "מחק" - מאשר את הביטול ומעביר את הטיפול לעמוד העורך
    async Task ConfirmCancel()
    {
        isCancelPopupOpen = false;

        await OnCancel.InvokeAsync();
    }


    // מסמן פריט כממתין לאישור מחיקה, ובכך פותח את הפופאפ
    void AskRemove(int index)
    {
        if (CanRemove() == false) return;

        removeIndex = index;
    }


    // מסיר את הפריט מהרשימה שבזיכרון ומודיע לעמוד.
    // כמו בשמירה, השינוי מגיע לשרת רק בשמירת השאלה
    async Task RemoveItem()
    {
        Question.Answers.RemoveAt(removeIndex);
        removeIndex = -1;

        await OnItemsChanged.InvokeAsync();
    }


    // ==========================================================
    // ערכי הקיצון
    // ==========================================================

    void OpenTagPopup(bool right)
    {
        isRightTag = right;

        if (right == true)
        {
            tagText = Question.RightTag ?? "";
        }
        else
        {
            tagText = Question.LeftTag ?? "";
        }

        origTagText = tagText;

        isTagPopupOpen = true;
    }


    // סוגר את פופאפ התגית בלי לשמור
    void CloseTagPopup()
    {
        isTagPopupOpen = false;
    }


    // צבע מונה התווים של התגית
    string TagCounterClass()
    {
        if (tagText.Length == 0)
        {
            return "chars-short";
        }

        return "chars-ok";
    }


    // תגית חייבת להיות לא ריקה ובתוך מגבלת 10 התווים
    bool CanSaveTag()
    {
        if (string.IsNullOrWhiteSpace(tagText) == true)
        {
            return false;
        }

        return tagText.Length <= TagMax;
    }


    // כותב את התגית שנערכה לשאלה, לפי הצד שנבחר בפתיחה
    void SaveTag()
    {
        if (isRightTag == true)
        {
            Question.RightTag = tagText.Trim();
        }
        else
        {
            Question.LeftTag = tagText.Trim();
        }

        isTagPopupOpen = false;
    }


    // ==========================================================
    // גרירה לשינוי הסדר
    // ==========================================================

    // תחילת גרירה: שומר מאיזה מיקום היא התחילה
    void StartDrag(int index)
    {
        dragIndex = index;
    }


    // הפריט הנגרר נכנס למקום שעליו שוחרר, והשאר נדחפים בהתאם
    async Task DropOn(int targetIndex)
    {
        if (dragIndex < 0 || dragIndex == targetIndex)
        {
            dragIndex = -1;
            return;
        }

        AnswerToEdit moved = Question.Answers[dragIndex];
        Question.Answers.RemoveAt(dragIndex);
        Question.Answers.Insert(targetIndex, moved);

        dragIndex = -1;
        await OnItemsChanged.InvokeAsync();
    }


    // סיום גרירה שלא הסתיימה בשחרור על פריט. איפוס המיקום
    // מונע מגרירה נטושה להשפיע על השחרור הבא
    void EndDrag()
    {
        dragIndex = -1;
    }


    // ==========================================================
    // עזרה
    // ==========================================================

    // ערך קיצון לא נשמר ריק - אם רוקן, חוזר לברירת המחדל
    async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(Question.RightTag))
        {
            Question.RightTag = "ראשון";
        }

        if (string.IsNullOrWhiteSpace(Question.LeftTag))
        {
            Question.LeftTag = "אחרון";
        }

        await OnSave.InvokeAsync();
    }


    // הטקסט שמופיע בטולטיפ של כפתור השמירה
    string SaveTip()
    {
        if (Question.Answers.Count < MinItems)
        {
            return "השאלה תישמר כטיוטה. לפרסום צריך לפחות 3 פריטים";
        }

        return "שמירת השאלה וחזרה לרשימה";
    }


    // כפתור השמירה פעיל רק כששאלה מלאה
    bool IsReady()
    {
        if (string.IsNullOrWhiteSpace(Question.RightTag))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(Question.LeftTag))
        {
            return false;
        }

        return true;
    }



    // כל עוד לא הוזן ערך קיצון, מוצג טקסט מציין מקום
    string TagText(string tag)
    {
        if (string.IsNullOrWhiteSpace(tag))
        {
            return "ערך קיצון";
        }

        return tag;
    }


    // ============================================================
    // מחזירה את מחלקת הגודל של הטקסט שעל הסלע.
    // כל התווים חייבים להיראות, ולכן ככל שהטקסט ארוך יותר הגופן
    // קטן יותר במקום שהטקסט ייחתך בשלוש נקודות
    // ============================================================
    string TextSize(string text)
    {
        int length = (text == null) ? 0 : text.Length;

        if (length <= 12)
        {
            return "";
        }

        if (length <= 20)
        {
            return "text-mid";
        }

        return "text-long";
    }
}
