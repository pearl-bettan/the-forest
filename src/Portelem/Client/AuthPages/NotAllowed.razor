@inject NavigationManager nav
@inject IConfiguration _config

@* ==========================================================
   מסך ההתחברות לפורטל"מ.

   הלוגיקה כאן זהה לחלוטין למקור, בכוונה: בזמן שהבדיקה רצה
   הקומפוננטה לא מרנדרת כלום, בדיוק כמו קודם. LoginWithPortelem
   מפנה את הדפדפן לפורטל"מ כשאין טוקן, וההשהיה של השנייה נותנת
   להפניה הזאת לקרות לפני שמשהו מוצג. רק אם ההתחברות באמת
   נכשלה מוצג מסך השגיאה של הפיגמה
   ========================================================== *@

<PageTitle>התחברות</PageTitle>

@if (!auth)
{
    <div class="auth-screen" role="alert">

        <StatusScreen Title="אוי לא משהו השתבש..."
                      Image="assets-images/dwarf-error.png">
            <button class="auth-retry" type="button"
                    title="ניסיון חוזר" @onclick="Reload">
                <img src="assets-images/refresh.png" alt="ניסיון חוזר" />
            </button>
        </StatusScreen>

        @* דרך המילוט כשההתחברות לא מצליחה שוב ושוב *@
        <a class="auth-portal" href="@_config["portelem:mainurl"]">מעבר לפורטל"מ</a>

    </div>
}


@code {
    [Inject]
    public IAuthenticationService _AuthService { get; set; }

    //משתמש ניסה להגיע למקום שאין לו הרשאות
    bool auth = true;

    protected override async Task OnInitializedAsync()
    {
        bool isAuth = await _AuthService.LoginWithPortelem();
        await Task.Delay(1000);
        auth = isAuth;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

    }

    // טעינה מחדש של העמוד. לא מריץ את ההתחברות שוב מתוך
    // הקומפוננטה, כדי לא להתערב בזרימת האימות
    private void Reload()
    {
        nav.NavigateTo(nav.Uri, forceLoad: true);
    }
}
